{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/sofa-solar-position.v1.json",
  "title": "Independent SOFA apparent-Sun oracle vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracle",
    "archiveUrl",
    "retrievedArchiveSha256",
    "driver",
    "assumptions",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "oracle": { "type": "string", "minLength": 1 },
    "archiveUrl": { "type": "string", "format": "uri" },
    "retrievedArchiveSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "driver": { "const": "script/sofa_solar_position_oracle.c" },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ephemerisTimeScale",
        "refraction",
        "horizontalOrigin",
        "futureTaiMinusUtcSeconds",
        "horizontalAxes"
      ],
      "properties": {
        "ephemerisTimeScale": { "const": "TT as TDB proxy" },
        "refraction": { "const": "disabled" },
        "horizontalOrigin": { "const": "WGS84 topocenter" },
        "futureTaiMinusUtcSeconds": { "const": 37 },
        "horizontalAxes": { "const": "east,north,up" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "observedAtIso",
          "location",
          "earthOrientation",
          "expectedHeliocentricEarthPositionAu",
          "expectedApparentEquatorialRadians",
          "expectedHorizontalEnu"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "observedAtIso": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["longitudeDegrees", "latitudeDegrees", "heightMeters"],
            "properties": {
              "longitudeDegrees": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "latitudeDegrees": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "heightMeters": { "type": "number" }
            }
          },
          "earthOrientation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dut1Seconds", "xpArcseconds", "ypArcseconds"],
            "properties": {
              "dut1Seconds": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "xpArcseconds": { "type": "number" },
              "ypArcseconds": { "type": "number" }
            }
          },
          "expectedApparentEquatorialRadians": {
            "$ref": "#/$defs/vector2"
          },
          "expectedHeliocentricEarthPositionAu": {
            "$ref": "#/$defs/vector3"
          },
          "expectedHorizontalEnu": {
            "$ref": "#/$defs/vector3"
          }
        }
      }
    }
  },
  "$defs": {
    "vector2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
