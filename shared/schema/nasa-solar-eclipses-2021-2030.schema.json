{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/nasa-solar-eclipses-2021-2030.schema.json",
  "title": "NASA solar-eclipse decade validation fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "purpose",
    "source",
    "tolerances",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "purpose": {
      "const": "Independent completeness, classification, and coarse seed-time oracle for bundled global solar-eclipse candidates. It does not validate local circumstances."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url",
        "retrievedAt",
        "timeScale",
        "attribution"
      ],
      "properties": {
        "title": { "const": "Solar Eclipses: 2021 - 2030" },
        "url": {
          "const": "https://eclipse.gsfc.nasa.gov/SEdecade/SEdecade2021.html"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date"
        },
        "timeScale": { "const": "TD (approximately TT)" },
        "attribution": {
          "const": "Eclipse Predictions by Fred Espenak, NASA's GSFC"
        }
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateMaximumTdbVsGreatestEclipseTdSeconds"
      ],
      "properties": {
        "candidateMaximumTdbVsGreatestEclipseTdSeconds": {
          "const": 90
        }
      }
    },
    "events": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "greatestEclipseTd",
        "classification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^se-20(?:2[1-9]|30)(?:0[1-9]|1[0-2])(?:0[1-9]|[12][0-9]|3[01])$"
        },
        "greatestEclipseTd": {
          "type": "string",
          "pattern": "^20(?:2[1-9]|30)-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$"
        },
        "classification": {
          "enum": ["partial", "annular", "total", "hybrid"]
        }
      }
    }
  }
}
