{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/sofa-diurnal-aberration.v1.json",
  "title": "Independent SOFA diurnal-aberration oracle vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "oracle",
    "releaseUrl",
    "archiveUrl",
    "retrievedArchiveSha256",
    "driver",
    "assumptions",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "oracle": {
      "const": "IAU SOFA ANSI C 2023-10-11 unmodified apio/atioq"
    },
    "releaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "archiveUrl": {
      "type": "string",
      "format": "uri"
    },
    "retrievedArchiveSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "driver": {
      "const": "script/sofa_observer_effects_oracle.c --fixtures"
    },
    "assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputFrame",
        "horizontalAxes",
        "longitude",
        "latitude",
        "polarMotionRadians",
        "tioLocatorRadians",
        "refractionConstantsRadians"
      ],
      "properties": {
        "inputFrame": {
          "const": "CIRS"
        },
        "horizontalAxes": {
          "const": "east,north,up"
        },
        "longitude": {
          "const": "east-positive geodetic radians"
        },
        "latitude": {
          "const": "WGS84 geodetic radians"
        },
        "polarMotionRadians": {
          "$ref": "#/$defs/zeroPair"
        },
        "tioLocatorRadians": {
          "const": 0
        },
        "refractionConstantsRadians": {
          "$ref": "#/$defs/zeroPair"
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/oracleCase"
      }
    }
  },
  "$defs": {
    "zeroPair": {
      "type": "array",
      "prefixItems": [
        {
          "const": 0
        },
        {
          "const": 0
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "unitVector": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "oracleCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dateUt1",
        "longitudeDegrees",
        "latitudeDegrees",
        "heightMeters",
        "hourAngleDegrees",
        "declinationDegrees",
        "diurnalAberrationMagnitude",
        "geometricHorizontalEnu",
        "expectedHorizontalEnu",
        "separationArcseconds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "dateUt1": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9.]+$"
        },
        "longitudeDegrees": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitudeDegrees": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "heightMeters": {
          "type": "number",
          "minimum": -10000,
          "maximum": 100000
        },
        "hourAngleDegrees": {
          "type": "number",
          "minimum": -360,
          "maximum": 360
        },
        "declinationDegrees": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "diurnalAberrationMagnitude": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 0.00001
        },
        "geometricHorizontalEnu": {
          "$ref": "#/$defs/unitVector"
        },
        "expectedHorizontalEnu": {
          "$ref": "#/$defs/unitVector"
        },
        "separationArcseconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
