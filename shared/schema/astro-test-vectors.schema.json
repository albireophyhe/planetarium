{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/astro-test-vectors.v1.json",
  "title": "Planetarium Cross-platform Astronomy Test Vectors",
  "type": "object",
  "required": [
    "schemaVersion",
    "angleUnit",
    "reference",
    "supportedDateRange",
    "units",
    "tolerances",
    "julianDates",
    "siderealTimes",
    "horizontalCoordinates",
    "projections",
    "realStarPositions",
    "precessionVectors",
    "angularDistances",
    "solarPositions",
    "twilightPhases"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "angleUnit": { "const": "degree" },
    "reference": {
      "type": "string",
      "pattern": "^docs/astronomy-model\\.md version 1"
    },
    "supportedDateRange": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "additionalProperties": false,
      "properties": {
        "minimum": {
          "type": "string",
          "format": "date-time",
          "const": "1900-01-01T00:00:00.000Z"
        },
        "maximum": {
          "type": "string",
          "format": "date-time",
          "const": "2100-12-31T23:59:59.999Z"
        }
      }
    },
    "units": {
      "type": "object",
      "required": [
        "angles",
        "catalogCoordinates",
        "longitude",
        "azimuth",
        "julianDate"
      ],
      "additionalProperties": false,
      "properties": {
        "angles": { "const": "degree" },
        "catalogCoordinates": { "const": "radian" },
        "longitude": { "const": "degree, east-positive" },
        "azimuth": { "const": "degree, north-zero and eastward" },
        "julianDate": { "const": "day" }
      }
    },
    "tolerances": {
      "type": "object",
      "required": [
        "basicAngleDegrees",
        "projectionNormalized",
        "realStarDegrees",
        "precessionDegrees",
        "angularDistanceDegrees",
        "solarDegrees"
      ],
      "additionalProperties": false,
      "properties": {
        "basicAngleDegrees": { "$ref": "#/$defs/positiveNumber" },
        "projectionNormalized": { "$ref": "#/$defs/positiveNumber" },
        "realStarDegrees": { "$ref": "#/$defs/positiveNumber" },
        "precessionDegrees": { "$ref": "#/$defs/positiveNumber" },
        "angularDistanceDegrees": { "$ref": "#/$defs/positiveNumber" },
        "solarDegrees": { "$ref": "#/$defs/positiveNumber" }
      }
    },
    "julianDates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "iso", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "iso": { "type": "string", "format": "date-time" },
          "expected": { "type": "number" }
        }
      }
    },
    "siderealTimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "julianDate", "longitude", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "julianDate": { "type": "number" },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "expected": { "$ref": "#/$defs/normalizedDegrees" }
        }
      }
    },
    "horizontalCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "latitude",
          "declination",
          "hourAngle",
          "altitude",
          "azimuth",
          "azimuthDefined"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "latitude": { "$ref": "#/$defs/latitude" },
          "declination": { "$ref": "#/$defs/latitude" },
          "hourAngle": { "type": "number", "minimum": -360, "maximum": 360 },
          "altitude": { "$ref": "#/$defs/latitude" },
          "azimuth": { "$ref": "#/$defs/normalizedDegrees" },
          "azimuthDefined": { "type": "boolean" }
        }
      }
    },
    "projections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "altitude", "azimuth", "x", "y"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "altitude": { "$ref": "#/$defs/latitude" },
          "azimuth": { "$ref": "#/$defs/normalizedDegrees" },
          "x": { "type": "number", "minimum": -2, "maximum": 2 },
          "y": { "type": "number", "minimum": -2, "maximum": 2 }
        }
      }
    },
    "realStarPositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "star", "iso", "location", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "star": { "$ref": "#/$defs/star" },
          "iso": { "type": "string", "format": "date-time" },
          "location": { "$ref": "#/$defs/location" },
          "expected": { "$ref": "#/$defs/horizontalExpected" }
        }
      }
    },
    "precessionVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "rightAscension",
          "declination",
          "julianDate",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "rightAscension": { "$ref": "#/$defs/normalizedDegrees" },
          "declination": { "$ref": "#/$defs/latitude" },
          "julianDate": { "type": "number" },
          "expected": { "$ref": "#/$defs/equatorialExpected" }
        }
      }
    },
    "angularDistances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "coordinateSystem",
          "first",
          "second",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "coordinateSystem": { "enum": ["equatorial", "horizontal"] },
          "first": { "$ref": "#/$defs/lonLat" },
          "second": { "$ref": "#/$defs/lonLat" },
          "expected": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          }
        }
      }
    },
    "solarPositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "iso", "location", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "iso": { "type": "string", "format": "date-time" },
          "location": { "$ref": "#/$defs/location" },
          "expected": { "$ref": "#/$defs/solarExpected" }
        }
      }
    },
    "twilightPhases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "altitude", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "altitude": { "$ref": "#/$defs/latitude" },
          "expected": { "$ref": "#/$defs/twilightPhase" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "normalizedDegrees": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 360
    },
    "location": {
      "type": "object",
      "required": ["id", "latitude", "longitude", "timeZone"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "latitude": { "$ref": "#/$defs/latitude" },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "timeZone": { "type": "string", "minLength": 1 }
      }
    },
    "star": {
      "type": "object",
      "required": ["hr", "name", "rightAscension", "declination"],
      "additionalProperties": false,
      "properties": {
        "hr": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "rightAscension": { "$ref": "#/$defs/normalizedDegrees" },
        "declination": { "$ref": "#/$defs/latitude" }
      }
    },
    "horizontalExpected": {
      "type": "object",
      "required": ["altitude", "azimuth", "azimuthDefined"],
      "additionalProperties": false,
      "properties": {
        "altitude": { "$ref": "#/$defs/latitude" },
        "azimuth": { "$ref": "#/$defs/normalizedDegrees" },
        "azimuthDefined": { "type": "boolean" }
      }
    },
    "equatorialExpected": {
      "type": "object",
      "required": ["rightAscension", "declination"],
      "additionalProperties": false,
      "properties": {
        "rightAscension": { "$ref": "#/$defs/normalizedDegrees" },
        "declination": { "$ref": "#/$defs/latitude" }
      }
    },
    "solarExpected": {
      "type": "object",
      "required": [
        "rightAscension",
        "declination",
        "altitude",
        "azimuth",
        "phase"
      ],
      "additionalProperties": false,
      "properties": {
        "rightAscension": { "$ref": "#/$defs/normalizedDegrees" },
        "declination": { "$ref": "#/$defs/latitude" },
        "altitude": { "$ref": "#/$defs/latitude" },
        "azimuth": { "$ref": "#/$defs/normalizedDegrees" },
        "phase": { "$ref": "#/$defs/twilightPhase" }
      }
    },
    "lonLat": {
      "type": "object",
      "required": ["longitude", "latitude"],
      "additionalProperties": false,
      "properties": {
        "longitude": { "$ref": "#/$defs/normalizedDegrees" },
        "latitude": { "$ref": "#/$defs/latitude" }
      }
    },
    "twilightPhase": {
      "enum": ["day", "civil", "nautical", "astronomical", "night"]
    }
  }
}
