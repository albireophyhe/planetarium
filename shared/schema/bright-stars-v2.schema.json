{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/bright-stars.v2.json",
  "title": "Planetarium Bright Star Catalog v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "epoch",
    "referenceSystem",
    "units",
    "astrometry",
    "columns",
    "stars",
    "source"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "epoch": { "const": "J2000.0" },
    "referenceSystem": { "const": "FK5" },
    "units": {
      "type": "object",
      "required": [
        "ra",
        "dec",
        "vMagnitude",
        "bvColor",
        "pmRaCosDec",
        "pmDec",
        "parallax",
        "radialVelocity"
      ],
      "additionalProperties": false,
      "properties": {
        "ra": { "const": "radian" },
        "dec": { "const": "radian" },
        "vMagnitude": { "const": "mag" },
        "bvColor": { "const": "mag" },
        "pmRaCosDec": { "const": "arcsec/year" },
        "pmDec": { "const": "arcsec/year" },
        "parallax": { "const": "arcsec" },
        "radialVelocity": { "const": "km/s" }
      }
    },
    "astrometry": {
      "type": "object",
      "required": [
        "properMotionConvention",
        "radialVelocityFrame",
        "catalogCoordinateResolution"
      ],
      "additionalProperties": false,
      "properties": {
        "properMotionConvention": {
          "const": "pmRA = cos(dec) * d(RA)/dt"
        },
        "radialVelocityFrame": { "const": "heliocentric" },
        "catalogCoordinateResolution": {
          "type": "object",
          "required": ["rightAscension", "declination"],
          "additionalProperties": false,
          "properties": {
            "rightAscension": { "const": "0.1 second of time" },
            "declination": { "const": "1 arcsecond" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "url",
        "catalogReadMe",
        "retrievedAt",
        "query",
        "sourceSha256",
        "attribution"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "catalogReadMe": { "type": "string", "format": "uri" },
        "dataPortal": { "type": "string", "format": "uri" },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "query": { "type": "object" },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attribution": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "prefixItems": [
        { "const": "hr" },
        { "const": "hd" },
        { "const": "raRad" },
        { "const": "decRad" },
        { "const": "vMagnitude" },
        { "const": "bvColor" },
        { "const": "catalogName" },
        { "const": "spectralType" },
        { "const": "pmRaCosDecArcsecPerYear" },
        { "const": "pmDecArcsecPerYear" },
        { "const": "parallaxArcsec" },
        { "const": "radialVelocityKmPerSecond" }
      ],
      "minItems": 12,
      "maxItems": 12,
      "items": false
    },
    "stars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "integer", "minimum": 1 },
          {
            "anyOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "null" }
            ]
          },
          {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 6.283185307179586
          },
          {
            "type": "number",
            "minimum": -1.5707963267948966,
            "maximum": 1.5707963267948966
          },
          { "type": "number", "minimum": -2, "maximum": 6.5 },
          {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          {
            "anyOf": [
              { "type": "number" },
              { "type": "null" }
            ]
          },
          {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          }
        ],
        "minItems": 12,
        "maxItems": 12,
        "items": false
      }
    }
  }
}
