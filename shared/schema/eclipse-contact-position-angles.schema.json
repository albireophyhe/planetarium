{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/eclipse-contact-position-angles.schema.json",
  "title": "Eclipse contact position-angle parity fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "convention",
    "toleranceDegrees",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "referenceDirection",
        "positiveDirection",
        "rangeDegrees"
      ],
      "properties": {
        "frame": {
          "const": "CIRS tangent plane (north from CIP)"
        },
        "referenceDirection": {
          "const": "celestial-north"
        },
        "positiveDirection": {
          "const": "eastward"
        },
        "rangeDegrees": {
          "const": "[0, 360)"
        }
      }
    },
    "toleranceDegrees": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.000001
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "referenceCenterDirection",
          "otherCenterDirection",
          "radialDirection",
          "expectedDegrees"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "referenceCenterDirection": {
            "$ref": "#/$defs/vector"
          },
          "otherCenterDirection": {
            "$ref": "#/$defs/vector"
          },
          "radialDirection": {
            "enum": [
              "toward-other-center",
              "away-from-other-center"
            ]
          },
          "expectedDegrees": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      }
    }
  },
  "$defs": {
    "vector": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
