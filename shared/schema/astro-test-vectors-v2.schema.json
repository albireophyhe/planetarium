{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/astro-test-vectors.v2.json",
  "title": "Planetarium Astronomy Test Vectors v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "angleUnit",
    "reference",
    "tolerances",
    "earthRotationAngles",
    "meanSiderealTimes",
    "nutationAngles",
    "fukushimaWilliamsAngles",
    "aberrationVectors",
    "refractionCoefficients",
    "composedApparentPositions",
    "accuracyScan"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "angleUnit": { "const": "radian" },
    "reference": {
      "type": "object",
      "required": [
        "implementation",
        "releasePage",
        "license",
        "archiveSha256",
        "officialTestProgramSha256",
        "officialVectorOrigin",
        "composedVectorOrigin",
        "jplApproximation"
      ],
      "additionalProperties": false,
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "releasePage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "format": "uri" },
        "archiveSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "officialTestProgramSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "officialVectorOrigin": { "type": "string", "minLength": 1 },
        "composedVectorOrigin": { "type": "string", "minLength": 1 },
        "jplApproximation": { "type": "string", "format": "uri" }
      }
    },
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "earthRotationAngles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scalarJulianVector" }
    },
    "meanSiderealTimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "ut1JulianDate",
          "ttJulianDate",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ut1JulianDate": { "type": "number" },
          "ttJulianDate": { "type": "number" },
          "expected": { "type": "number" }
        }
      }
    },
    "nutationAngles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/angleObjectVector" }
    },
    "fukushimaWilliamsAngles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "ttJulianDate", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "ttJulianDate": { "type": "number" },
          "expected": {
            "type": "object",
            "required": ["gamma", "phi", "psi", "obliquity"],
            "additionalProperties": false,
            "properties": {
              "gamma": { "type": "number" },
              "phi": { "type": "number" },
              "psi": { "type": "number" },
              "obliquity": { "type": "number" }
            }
          }
        }
      }
    },
    "aberrationVectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "naturalDirection",
          "observerBarycentricVelocityC",
          "sunObserverDistanceAu",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "naturalDirection": { "$ref": "#/$defs/vector3" },
          "observerBarycentricVelocityC": { "$ref": "#/$defs/vector3" },
          "sunObserverDistanceAu": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "expected": { "$ref": "#/$defs/vector3" }
        }
      }
    },
    "refractionCoefficients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "atmosphere", "expected"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "atmosphere": { "$ref": "#/$defs/atmosphere" },
          "expected": {
            "type": "object",
            "required": ["tangent", "tangentCubed"],
            "additionalProperties": false,
            "properties": {
              "tangent": { "type": "number" },
              "tangentCubed": { "type": "number" }
            }
          }
        }
      }
    },
    "composedApparentPositions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "iso",
          "starHR",
          "earthOrientation",
          "location",
          "aberration",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "iso": { "type": "string", "format": "date-time" },
          "starHR": { "type": "integer", "minimum": 1 },
          "earthOrientation": {
            "type": "object",
            "required": ["taiMinusUtcSeconds", "dut1Seconds"],
            "additionalProperties": false,
            "properties": {
              "taiMinusUtcSeconds": { "type": "number" },
              "dut1Seconds": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          },
          "location": { "$ref": "#/$defs/location" },
          "aberration": {
            "type": "object",
            "required": [
              "observerBarycentricVelocityC",
              "sunObserverDistanceAu"
            ],
            "additionalProperties": false,
            "properties": {
              "observerBarycentricVelocityC": {
                "$ref": "#/$defs/vector3"
              },
              "sunObserverDistanceAu": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "astrometricRightAscension",
              "astrometricDeclination",
              "apparentRightAscension",
              "apparentDeclination",
              "greenwichApparentSiderealTime",
              "altitude",
              "azimuth"
            ],
            "additionalProperties": false,
            "properties": {
              "astrometricRightAscension": { "type": "number" },
              "astrometricDeclination": { "type": "number" },
              "apparentRightAscension": { "type": "number" },
              "apparentDeclination": { "type": "number" },
              "greenwichApparentSiderealTime": { "type": "number" },
              "altitude": { "type": "number" },
              "azimuth": { "type": "number" }
            }
          }
        }
      }
    },
    "accuracyScan": {
      "type": "object",
      "required": [
        "range",
        "dateStepDays",
        "dateSamples",
        "directionGrid",
        "siderealLeadingEquationOfEquinoxes",
        "jplApproximateAberrationVersusSofaEpv00"
      ],
      "additionalProperties": false,
      "properties": {
        "range": {
          "type": "object",
          "required": ["minimumJulianDate", "maximumJulianDate"],
          "additionalProperties": false,
          "properties": {
            "minimumJulianDate": { "type": "number" },
            "maximumJulianDate": { "type": "number" }
          }
        },
        "dateStepDays": { "type": "number", "exclusiveMinimum": 0 },
        "dateSamples": { "type": "integer", "minimum": 1 },
        "directionGrid": {
          "type": "object",
          "required": [
            "rightAscensionStepDegrees",
            "declinationsDegrees",
            "samples"
          ],
          "additionalProperties": false,
          "properties": {
            "rightAscensionStepDegrees": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "declinationsDegrees": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "samples": { "type": "integer", "minimum": 1 }
          }
        },
        "siderealLeadingEquationOfEquinoxes": {
          "$ref": "#/$defs/errorMeasurement"
        },
        "jplApproximateAberrationVersusSofaEpv00": {
          "type": "object",
          "required": [
            "maximumDifferenceMilliarcseconds",
            "rmsDifferenceMilliarcseconds",
            "maximumVelocityDifferenceMetersPerSecond"
          ],
          "additionalProperties": false,
          "properties": {
            "maximumDifferenceMilliarcseconds": {
              "type": "number",
              "minimum": 0
            },
            "rmsDifferenceMilliarcseconds": {
              "type": "number",
              "minimum": 0
            },
            "maximumVelocityDifferenceMetersPerSecond": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "minItems": 3,
      "maxItems": 3,
      "items": false
    },
    "scalarJulianVector": {
      "type": "object",
      "required": ["id", "ut1JulianDate", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ut1JulianDate": { "type": "number" },
        "expected": { "type": "number" }
      }
    },
    "angleObjectVector": {
      "type": "object",
      "required": ["id", "ttJulianDate", "expected"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ttJulianDate": { "type": "number" },
        "expected": {
          "type": "object",
          "required": ["longitude", "obliquity"],
          "additionalProperties": false,
          "properties": {
            "longitude": { "type": "number" },
            "obliquity": { "type": "number" }
          }
        }
      }
    },
    "atmosphere": {
      "type": "object",
      "required": [
        "pressureHpa",
        "temperatureCelsius",
        "relativeHumidity",
        "wavelengthMicrometers"
      ],
      "additionalProperties": false,
      "properties": {
        "pressureHpa": { "type": "number" },
        "temperatureCelsius": { "type": "number" },
        "relativeHumidity": { "type": "number" },
        "wavelengthMicrometers": { "type": "number" }
      }
    },
    "location": {
      "type": "object",
      "required": ["latitude", "longitude", "timeZone"],
      "additionalProperties": false,
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "timeZone": { "type": "string", "minLength": 1 }
      }
    },
    "errorMeasurement": {
      "type": "object",
      "required": [
        "maximumDifferenceMilliarcseconds",
        "rmsDifferenceMilliarcseconds"
      ],
      "additionalProperties": false,
      "properties": {
        "maximumDifferenceMilliarcseconds": {
          "type": "number",
          "minimum": 0
        },
        "rmsDifferenceMilliarcseconds": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
