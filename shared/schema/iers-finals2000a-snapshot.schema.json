{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/iers-finals2000a-snapshot.v1.json",
  "title": "Planetarium IERS finals2000A source snapshot metadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "retrievedAt",
    "sourceLastModified",
    "sourceUrl",
    "sourceSha256",
    "officialSourceSha512",
    "formatUrl",
    "formatSha256",
    "checksumUrl",
    "checksumSha256",
    "productMetadataUrl",
    "distributionUrl"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "sourceLastModified": {
      "type": "string",
      "format": "date-time"
    },
    "sourceUrl": {
      "const": "https://maia.usno.navy.mil/ser7/finals2000A.all"
    },
    "sourceSha256": { "$ref": "#/$defs/sha256" },
    "officialSourceSha512": { "$ref": "#/$defs/sha512" },
    "formatUrl": {
      "const": "https://maia.usno.navy.mil/ser7/readme.finals2000A"
    },
    "formatSha256": { "$ref": "#/$defs/sha256" },
    "checksumUrl": {
      "const": "https://maia.usno.navy.mil/ser7/checksums.sha512"
    },
    "checksumSha256": { "$ref": "#/$defs/sha256" },
    "productMetadataUrl": { "type": "string", "format": "uri" },
    "distributionUrl": {
      "const": "https://maia.usno.navy.mil/products/daily"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  }
}
