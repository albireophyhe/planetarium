{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planetarium.local/schema/truncated-earth-heliocentric.v1.json",
  "title": "Truncated heliocentric Earth ephemeris coefficients",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "model",
    "source",
    "truncation",
    "units",
    "bcrsOrientationMatrix",
    "series"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "model": { "const": "truncated-vsop2000-earth-heliocentric" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "sourceRoutine",
        "sourceFileSha256",
        "archiveUrl",
        "archiveSha256"
      ],
      "properties": {
        "release": { "const": "IAU SOFA ANSI C 2023-10-11" },
        "sourceRoutine": { "const": "epv00" },
        "sourceFileSha256": {
          "const": "939d57fb2556dcd065370e090df962a7d459a89d972e7fe1b9b250306fe73c8a"
        },
        "archiveUrl": {
          "const": "https://www.iausofa.org/s/sofa_c-20231011tar.gz"
        },
        "archiveSha256": {
          "const": "d9c10833cae8b4d9361a0ffda31ec361fd1262362025bec4d4e51a880150ace2"
        }
      }
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "referenceSpanJulianYears",
        "fullTermCount",
        "retainedTermCount"
      ],
      "properties": {
        "rule": {
          "const": "top terms by abs(amplitude) * referenceSpanJulianYears ** timePower"
        },
        "referenceSpanJulianYears": { "const": 100 },
        "fullTermCount": { "const": 1323 },
        "retainedTermCount": { "const": 200 }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amplitude", "phase", "frequency"],
      "properties": {
        "amplitude": { "const": "au" },
        "phase": { "const": "radian" },
        "frequency": { "const": "radian per Julian year" }
      }
    },
    "bcrsOrientationMatrix": {
      "type": "array",
      "prefixItems": [
        { "$ref": "#/$defs/vector3" },
        { "$ref": "#/$defs/vector3" },
        { "$ref": "#/$defs/vector3" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "e0x",
        "e0y",
        "e0z",
        "e1x",
        "e1y",
        "e1z",
        "e2x",
        "e2y",
        "e2z"
      ],
      "properties": {
        "e0x": { "$ref": "#/$defs/series" },
        "e0y": { "$ref": "#/$defs/series" },
        "e0z": { "$ref": "#/$defs/series" },
        "e1x": { "$ref": "#/$defs/series" },
        "e1y": { "$ref": "#/$defs/series" },
        "e1z": { "$ref": "#/$defs/series" },
        "e2x": { "$ref": "#/$defs/series" },
        "e2y": { "$ref": "#/$defs/series" },
        "e2z": { "$ref": "#/$defs/series" }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "prefixItems": [
        { "type": "number" },
        { "type": "number" },
        { "type": "number" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "series": {
      "type": "array",
      "items": { "$ref": "#/$defs/vector3" }
    }
  }
}
